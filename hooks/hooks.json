{
  "description": "atlias: links the session to the sub-harness at start (progress note, shared memory, graphify god nodes, companion skills), answers codebase questions from the graph before the model reads files, guards against repeated identical tool calls and destructive commands, tracks every changed file, runs a syntax and two-pass verification gate before the reply ends, writes a handoff note before compaction and re-injects it after, and hands each session to Dream for memory consolidation at exit.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" session-start", "timeout": 45 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" prompt", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" pre-tool", "timeout": 8 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" post-tool", "timeout": 8 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" pre-compact", "timeout": 15 }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" post-compact", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" stop", "timeout": 30 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" subagent-stop", "timeout": 8 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" session-end", "timeout": 5 }
        ]
      }
    ]
  }
}
